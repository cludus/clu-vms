#!/usr/bin/env bash

root_dir="$(dirname "$(dirname "$(readlink -f "$0")")")"
tpls_dir="$root_dir/tpls"
out_file="$root_dir/bin/inc/templates"
dist_dir="$root_dir/dist"
dist_file="$dist_dir/cvms"
cvms_file="$root_dir/bin/cvms"

function compile_help() {
  echo "======================="
  echo "Compile CVMS Assets"
  echo "  Usage: compile"
  echo "  Generates bin/inc/templates with preloaded template content."
  echo "  Generates dist/cvms as a portable single-file script."
  echo ""
}

function append_file_without_shebang() {
  local source_file="$1"
  local target_file="$2"
  # Skip the first line (shebang) for embedded scripts.
  tail -n +2 "$source_file" >> "$target_file"
  echo "" >> "$target_file"
}

function build_dist_cvms() {
  mkdir -p "$dist_dir"
  rm -f "$dist_dir/cmvs"

  local required_files=(
    "$cvms_file"
    "$root_dir/bin/inc/utils"
    "$root_dir/bin/inc/download"
    "$root_dir/bin/inc/gen-cloud-init"
    "$root_dir/bin/inc/run-cloud-init"
    "$root_dir/bin/inc/stop"
    "$out_file"
  )

  for f in "${required_files[@]}"; do
    if [[ ! -f "$f" ]]; then
      echo "Error: Required file $f not found."
      exit 1
    fi
  done

  {
    echo "#!/usr/bin/env bash"
    echo ""
    echo "# Generated by bin/compile. Portable single-file distribution of cvms."
    echo ""
  } > "$dist_file"

  append_file_without_shebang "$root_dir/bin/inc/utils" "$dist_file"
  append_file_without_shebang "$root_dir/bin/inc/download" "$dist_file"
  append_file_without_shebang "$root_dir/bin/inc/gen-cloud-init" "$dist_file"
  append_file_without_shebang "$root_dir/bin/inc/run-cloud-init" "$dist_file"
  append_file_without_shebang "$root_dir/bin/inc/stop" "$dist_file"
  append_file_without_shebang "$out_file" "$dist_file"

  # Inline cvms script body, skipping include source lines because content is
  # embedded above.
  grep -vE '^[[:space:]]*(source|\.)[[:space:]]+"\$bin_dir/inc/(utils|download|gen-cloud-init|run-cloud-init|stop)"[[:space:]]*$' "$cvms_file" | tail -n +2 >> "$dist_file"

  chmod +x "$dist_file"
  echo "Generated $dist_file"
}

function do_compile() {
  local meta_tpl_path="$tpls_dir/meta-data.j2"
  local user_tpl_path="$tpls_dir/alpine_user-data.j2"
  local network_tpl_path="$tpls_dir/alpine_network-config.j2"

  for tpl in "$meta_tpl_path" "$user_tpl_path" "$network_tpl_path"; do
    if [[ ! -f "$tpl" ]]; then
      echo "Error: Template file $tpl not found."
      exit 1
    fi
  done

  local meta_tpl_content
  local user_tpl_content
  local network_tpl_content
  meta_tpl_content=$(cat "$meta_tpl_path")
  user_tpl_content=$(cat "$user_tpl_path")
  network_tpl_content=$(cat "$network_tpl_path")

  {
    echo "#!/usr/bin/env bash"
    echo ""
    echo "# Generated by bin/compile. Do not edit manually."
    printf 'CVMS_TEMPLATE_META_DATA=%q\n' "$meta_tpl_content"
    printf 'CVMS_TEMPLATE_ALPINE_USER_DATA=%q\n' "$user_tpl_content"
    printf 'CVMS_TEMPLATE_ALPINE_NETWORK_CONF=%q\n' "$network_tpl_content"
  } > "$out_file"

  echo "Generated $out_file"
  build_dist_cvms
}

case "${1:-compile}" in
  ""|compile)
    do_compile
    ;;
  help|--help|-h)
    compile_help
    ;;
  *)
    echo "Unknown command: $1"
    compile_help
    exit 1
    ;;
esac
