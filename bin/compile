#!/usr/bin/env bash

root_dir="$(dirname "$(dirname "$(readlink -f "$0")")")"
tpls_dir="$root_dir/tpls"
out_file="$root_dir/bin/inc/templates"

function compile_help() {
  echo "======================="
  echo "Compile CVMS Assets"
  echo "  Usage: compile"
  echo "  Generates bin/inc/templates with preloaded template content."
  echo ""
}

function do_compile() {
  local meta_tpl_path="$tpls_dir/meta-data.j2"
  local user_tpl_path="$tpls_dir/alpine_user-data.j2"
  local network_tpl_path="$tpls_dir/alpine_network-config.j2"

  for tpl in "$meta_tpl_path" "$user_tpl_path" "$network_tpl_path"; do
    if [[ ! -f "$tpl" ]]; then
      echo "Error: Template file $tpl not found."
      exit 1
    fi
  done

  local meta_tpl_content
  local user_tpl_content
  local network_tpl_content
  meta_tpl_content=$(cat "$meta_tpl_path")
  user_tpl_content=$(cat "$user_tpl_path")
  network_tpl_content=$(cat "$network_tpl_path")

  {
    echo "#!/usr/bin/env bash"
    echo ""
    echo "# Generated by bin/compile. Do not edit manually."
    printf 'CVMS_TEMPLATE_META_DATA=%q\n' "$meta_tpl_content"
    printf 'CVMS_TEMPLATE_ALPINE_USER_DATA=%q\n' "$user_tpl_content"
    printf 'CVMS_TEMPLATE_ALPINE_NETWORK_CONF=%q\n' "$network_tpl_content"
  } > "$out_file"

  echo "Generated $out_file"
}

case "${1:-compile}" in
  ""|compile)
    do_compile
    ;;
  help|--help|-h)
    compile_help
    ;;
  *)
    echo "Unknown command: $1"
    compile_help
    exit 1
    ;;
esac
