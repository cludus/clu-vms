#!/usr/bin/env bash

cd "$(dirname "$(dirname "$(readlink -f "$0")")")"
root_dir=$(pwd)

source "$root_dir/bin/inc/download"

function help_message() {
  echo "======================="
  echo "CVMS - Cludus Cloud Virtual Machine Setup"
  echo "Commands:"
  download_help
  echo ""
}

function do_start {
  command=$1
  shift
  case $command in
    download)
      do_download "$@"
      ;;
    "")
      help_message
      ;;
    "help")
      help_message
      ;;
    *)
      echo "Unknown command: $command"
      help_message
      ;;
  esac
}

do_start "$@"
