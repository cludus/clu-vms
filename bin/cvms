#!/usr/bin/env bash

root_dir="$(dirname "$(dirname "$(readlink -f "$0")")")"
bin_dir="$root_dir/bin"
ROOT_SCRIPT="cvms"
ASSETS_DIR=".assets"
TPLS_DIR="$root_dir/tpls"

source "$bin_dir/inc/utils"
source "$bin_dir/inc/download"
source "$bin_dir/inc/gen-cloud-init"
source "$bin_dir/inc/gen-flatcar"
source "$bin_dir/inc/run-cloud-init"
source "$bin_dir/inc/stop"

function help_message() {
  echo "======================="
  echo "CVMS - Cludus Cloud Virtual Machine Setup"
  echo "Commands:"
  echo ""
  download_help
  gen-cloud-init_help
  gen-flatcar_help
  run-cloud-init_help
  stop_help
  echo ""
}

function do_start() {
  command=$1
  shift
  case $command in
    download)
      do_download "$@"
      ;;
    gen-cloud-init)
      if [[ -z "${CVMS_TEMPLATE_META_DATA:-}" || -z "${CVMS_TEMPLATE_ALPINE_USER_DATA:-}" || -z "${CVMS_TEMPLATE_ALPINE_NETWORK_CONF:-}" ]]; then
        local templates_inc="$bin_dir/inc/templates"
        if [[ ! -f "$templates_inc" ]]; then
          echo "Error: Compiled templates file $templates_inc not found. Please run ./bin/compile first."
          exit 1
        fi
        source "$templates_inc"
      fi

      do_gen-cloud-init "$@"
      ;;
    gen-flatcar)
      if [[ -z "${CVMS_TEMPLATE_FLATCAR_BUTANE:-}" ]]; then
        local templates_inc="$bin_dir/inc/templates"
        if [[ ! -f "$templates_inc" ]]; then
          echo "Error: Compiled templates file $templates_inc not found. Please run ./bin/compile first."
          exit 1
        fi
        source "$templates_inc"
      fi

      do_gen-flatcar "$@"
      ;;
    run-cloud-init)
      do_run-cloud-init "$@"
      ;;
    stop)
      do_stop "$@"
      ;;
    "")
      help_message
      ;;
    "help")
      help_message
      ;;
    *)
      echo "Unknown command: $command"
      echo "Please check the available commands below:"
      echo ""
      help_message
      ;;
  esac
}

do_start "$@"
