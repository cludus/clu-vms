#!/usr/bin/env bash

root_dir="$(dirname "$(dirname "$(readlink -f "$0")")")"
bin_dir="$root_dir/bin"
ROOT_SCRIPT="cvms"
ASSETS_DIR=".assets"
TPLS_DIR="$root_dir/tpls"

source "$bin_dir/inc/utils"
source "$bin_dir/inc/download"
source "$bin_dir/inc/gen-cloud-init"
source "$bin_dir/inc/run-cloud-init"
source "$bin_dir/inc/stop"

function help_message() {
  echo "======================="
  echo "CVMS - Cludus Cloud Virtual Machine Setup"
  echo "Commands:"
  echo ""
  download_help
  gen-cloud-init_help
  run-cloud-init_help
  stop_help
  echo ""
}

function do_start() {
  command=$1
  shift
  case $command in
    download)
      do_download "$@"
      ;;
    gen-cloud-init)
      local meta_tpl_path="$TPLS_DIR/meta-data.j2"
      local user_tpl_path="$TPLS_DIR/alpine_user-data.j2"
      local network_tpl_path="$TPLS_DIR/alpine_network-config.j2"

      for tpl in "$meta_tpl_path" "$user_tpl_path" "$network_tpl_path"; do
        if [[ ! -f "$tpl" ]]; then
          echo "Error: Template file $tpl not found."
          exit 1
        fi
      done

      local meta_tpl_content
      local user_tpl_content
      local network_tpl_content
      meta_tpl_content=$(cat "$meta_tpl_path")
      user_tpl_content=$(cat "$user_tpl_path")
      network_tpl_content=$(cat "$network_tpl_path")

      do_gen-cloud-init "$meta_tpl_content" "$user_tpl_content" "$network_tpl_content" "$@"
      ;;
    run-cloud-init)
      do_run-cloud-init "$@"
      ;;
    stop)
      do_stop "$@"
      ;;
    "")
      help_message
      ;;
    "help")
      help_message
      ;;
    *)
      echo "Unknown command: $command"
      echo "Please check the available commands below:"
      echo ""
      help_message
      ;;
  esac
}

do_start "$@"
