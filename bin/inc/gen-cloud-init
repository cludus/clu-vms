# root_dir is inherited from the calling script (cvms.sh) and points to the root directory of the project.
ROOT_DIR="${root_dir:-$(pwd)}"

function gen-cloud-init_help() {
  echo "======================="
  echo "Generate Cloud-Init Configuration"
  echo "  Usage: $0 gen-cloud-init"
  echo "  Generates the cloud-init image."
  echo ""
}

function copy_base_os_image() {
  local os_name="alpine"
  local os_image="$os_name.img"

  local source_dir="${ROOT_DIR}/imgs"
  local source_file="${source_dir}/${os_image}"
  if [[ ! -f "$source_file" ]]; then
    echo "Error: Base OS image $source_file not found. Please run the download command first."
    exit 1
  fi
  # Delete the existing OS image if it exists
  if [[ -f "${os_image}" ]]; then
    rm -f "${os_image}"
  fi
  cp "$source_file" "${os_image}"

  echo "$os_name"
}

function render_j2() {
  local tpl_path="$1"
  local out_path="$2"
  shift 2

  python3 -c '
import jinja2, os, sys
tpl_path = sys.argv[1]
out_path = sys.argv[2]
env = jinja2.Environment(loader=jinja2.FileSystemLoader(os.path.dirname(tpl_path)))
tpl = env.get_template(os.path.basename(tpl_path))
ctx = {}
for arg in sys.argv[3:]:
    k, v = arg.split("=", 1)
    ctx[k] = v
with open(out_path, "w") as f:
    f.write(tpl.render(**ctx))
' "$tpl_path" "$out_path" "$@"
}

function process_host() {
  local host="$1"
  local default_user="$2"
  local default_pass="$3"
  local default_os="$4"
  local default_bridge="$5"
  local os_name="$6"
  local name=$(echo "$host" | yq '.name')
  local ip=$(echo "$host" | yq '.ip')
  # Derive gateway from IP (replace last octet with .1)
  local gateway=$(echo "$ip" | sed 's/\.[0-9]*$/.1/')

  echo "Processing host: $name with IP: $ip"

  # generate config files for cloud-init to config folder
  local config_dir="$name/config"
  mkdir -p "$config_dir"

  local os_network_tpl="${os_name}_network-config.j2"
  render_j2 "${ROOT_DIR}/tpls/meta-data.j2"      "$config_dir/meta-data"      "name=$name"
  render_j2 "${ROOT_DIR}/tpls/user-data.j2"      "$config_dir/user-data"      "user=$default_user" "pass=$default_pass" "name=$name"
  render_j2 "${ROOT_DIR}/tpls/${os_network_tpl}" "$config_dir/network-config" "ip=$ip" "gateway=$gateway" "name=$name"

  # generate iso image with cloud-init config files
  local seed_img="$name/seed.img"
  # Delete the existing seed image if it exists
  if [[ -f "${seed_img}" ]]; then
    rm -f "${seed_img}"
  fi
  genisoimage \
    -output "$seed_img" \
    -volid cidata -rational-rock -joliet \
    "$config_dir/user-data" "$config_dir/meta-data" "$config_dir/network-config"

  echo ""
  echo "Generated cloud-init seed image for $name at $seed_img"
  echo ""
}

function do_gen-cloud-init() {
  echo "Generating cloud-init configuration for all hosts defined in vms.yml..."
  echo ""

  if [[ ! -f "vms.yml" ]]; then
    echo "Error: vms.yml not found in the current directory. Please ensure you are in the correct directory and that vms.yml exists."
    exit 1
  fi

  # check required tools are installed
  for tool in yq genisoimage; do
    if ! command -v "$tool" &> /dev/null; then
      echo "Error: $tool is not installed. Please install it and try again."
      exit 1
    fi
  done

  # Check for Python jinja2 module
  if ! python3 -c "import jinja2" &> /dev/null; then
    echo "Error: Python jinja2 module is not installed. Please run: pip install jinja2"
    exit 1
  fi

  local default_user=$(yq '.defaults.user' vms.yml)
  local default_pass=$(yq '.defaults.pass' vms.yml)
  local default_os=$(yq '.defaults.os' vms.yml)
  local default_bridge=$(yq '.defaults.bridge' vms.yml)

  local os_name=$(copy_base_os_image)
  echo "Copied OS image: $os_name.img"
  echo ""

  readarray -t hosts < <(yq -o=json -I=0 '.hosts[]' vms.yml)
  for host in "${hosts[@]}"; do
    process_host "$host" "$default_user" "$default_pass" "$default_os" "$default_bridge" "$os_name"
  done
}