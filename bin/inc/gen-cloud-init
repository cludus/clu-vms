# root_dir is inherited from the calling script (cvms.sh) and points to the root directory of the project.
ROOT_DIR="${root_dir:-$(pwd)}"

function gen-cloud-init_help() {
  echo "======================="
  echo "Generate Cloud-Init Configuration"
  echo "  Usage: $0 gen-cloud-init"
  echo "  Generates the cloud-init image."
  echo ""
}

function copy_base_os_image() {
  local os_image="alpine.img"

  local source_dir="${ROOT_DIR}/imgs"
  local source_file="${source_dir}/${os_image}"
  if [[ ! -f "$source_file" ]]; then
    echo "Error: Base OS image $source_file not found. Please run the download command first."
    exit 1
  fi
  # Delete the existing OS image if it exists
  if [[ -f "${os_image}" ]]; then
    rm -f "${os_image}"
  fi
  cp "$source_file" "${os_image}"

  echo "$os_image"
}

