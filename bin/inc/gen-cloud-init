#!/usr/bin/env bash

ROOT_SCRIPT="${ROOT_SCRIPT:-cvms}"
ASSETS_DIR="${ASSETS_DIR:-.assets}"

function gen-cloud-init_help() {
  echo "======================="
  echo "Generate Cloud-Init Configuration"
  echo "  Usage: $ROOT_SCRIPT gen-cloud-init"
  echo "  Generates the cloud-init image."
  echo ""
}

function generate_host() {
  local host="$1"
  local default_user="$2"
  local default_pass="$3"
  local default_os="$4"
  local default_bridge="$5"
  local default_storage_size="$6"
  local name=$(echo "$host" | yq '.name')
  local ip=$(echo "$host" | yq '.ip')
  # Per-host bridge override; falls back to the default bridge from vms.yml
  local bridge=$(echo "$host" | yq '.bridge // ""' )
  if [[ -z "$bridge" ]]; then
    bridge="$default_bridge"
  fi
  # Optional per-host VLAN tag (empty means untagged)
  local vlan=$(echo "$host" | yq '.vlan // ""' )
  # Derive gateway from IP (replace last octet with .1)
  local gateway=$(echo "$ip" | sed 's/\.[0-9]*$/.1/')

  local os_name=$(copy_base_os_image "$name" "$default_os")
  echo "Processing host: $name with IP: $ip (OS: $os_name, bridge: $bridge${vlan:+, vlan: $vlan})"

  # generate config files for cloud-init to config folder
  local config_dir="$ASSETS_DIR/$name/config"
  mkdir -p "$config_dir"

  render_j2_content "$CVMS_TEMPLATE_META_DATA"          "$config_dir/meta-data" "name=$name"
  render_j2_content "$CVMS_TEMPLATE_ALPINE_USER_DATA"   "$config_dir/user-data" "user=$default_user" "pass=$default_pass" "name=$name"
  render_j2_content "$CVMS_TEMPLATE_ALPINE_NETWORK_CONF" "$config_dir/network-config" "ip=$ip" "gateway=$gateway" "name=$name"

  # generate iso image with cloud-init config files
  local seed_img="$ASSETS_DIR/$name/seed.img"
  # Delete the existing seed image if it exists
  if [[ -f "${seed_img}" ]]; then
    rm -f "${seed_img}"
  fi
  genisoimage \
    -output "$seed_img" \
    -volid cidata -rational-rock -joliet \
    "$config_dir/user-data" "$config_dir/meta-data" "$config_dir/network-config"
  echo "Generated cloud-init seed image for $name at $seed_img"
  echo ""

  # generate storage file if it doesn't exist
  if [[ ! -f "${name}-data.qcow2" ]]; then
    qemu-img create -f qcow2 "${name}-data.qcow2" "$default_storage_size"
    echo "Generated storage file for $name at ${name}-data.qcow2 with size $default_storage_size"
    format_data_disk "${name}-data.qcow2"
  else
    echo "Storage file already exists for $name at ${name}-data.qcow2 — preserved"
    echo ""
  fi
}

function do_gen-cloud-init() {
  echo "Generating cloud-init configuration for all hosts defined in vms.yml..."
  echo ""

  if [[ -z "${CVMS_TEMPLATE_META_DATA:-}" || -z "${CVMS_TEMPLATE_ALPINE_USER_DATA:-}" || -z "${CVMS_TEMPLATE_ALPINE_NETWORK_CONF:-}" ]]; then
    echo "Error: Missing compiled template content. Please run ./bin/compile and try again."
    exit 1
  fi

  if [[ ! -f "vms.yml" ]]; then
    echo "Error: vms.yml not found in the current directory. Please ensure you are in the correct directory and that vms.yml exists."
    exit 1
  fi

  # check required tools are installed
  for tool in yq genisoimage qemu-img qemu-nbd sfdisk mkfs.ext4; do
    if ! command -v "$tool" &> /dev/null; then
      echo "Error: $tool is not installed. Please install it and try again."
      exit 1
    fi
  done

  local default_user=$(yq '.defaults.user' vms.yml)
  local default_pass=$(yq '.defaults.pass' vms.yml)
  local default_os=$(yq '.defaults.os' vms.yml)
  local default_bridge=$(yq '.defaults.bridge' vms.yml)
  local default_storage_size=$(yq '.defaults.storage_size' vms.yml)

  # Ensure the bridge used for qemu networking exists on the host before generating any per-VM configuration.
  check_bridge

  readarray -t hosts < <(yq -o=json -I=0 '.hosts[]' vms.yml)
  for host in "${hosts[@]}"; do
    generate_host "$host" "$default_user" "$default_pass" "$default_os" "$default_bridge" "$default_storage_size"
  done
}