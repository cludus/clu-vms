#!/usr/bin/env bash

ROOT_SCRIPT="${ROOT_SCRIPT:-cvms}"
ASSETS_DIR="${ASSETS_DIR:-.assets}"

function gen-cloud-init_help() {
  echo "======================="
  echo "Generate Cloud-Init Configuration"
  echo "  Usage: $ROOT_SCRIPT gen-cloud-init"
  echo "  Generates the cloud-init image."
  echo ""
}

function copy_base_os_image() {
  local vm_name="$1"
  local os_name="alpine"
  local os_image="$os_name.img"

  local source_dir="$ASSETS_DIR/imgs"
  local source_file="${source_dir}/${os_image}"
  if [[ ! -f "$source_file" ]]; then
    echo "Error: Base OS image $source_file not found. Please run the download command first."
    exit 1
  fi

  local dest="$ASSETS_DIR/${vm_name}/${os_image}"
  mkdir -p "$ASSETS_DIR/$vm_name"
  # Delete the existing OS image if it exists
  if [[ -f "$dest" ]]; then
    rm -f "$dest"
  fi
  cp "$source_file" "$dest"

  echo "$os_name"
}

# Partition and format a qcow2 data disk with a single ext4 partition via NBD.
# Usage: format_data_disk <qcow2_path>
function format_data_disk() {
  local disk="$1"

  # Find a free nbd device
  local nbd_dev=""
  for nbd in /dev/nbd[0-9]*; do
    local idx="${nbd#/dev/nbd}"
    local size_file="/sys/class/block/nbd${idx}/size"
    if [[ -f "$size_file" ]]; then
      local sz
      sz=$(cat "$size_file" 2>/dev/null)
      if [[ "$sz" == "0" ]]; then
        nbd_dev="$nbd"
        break
      fi
    fi
  done

  if [[ -z "$nbd_dev" ]]; then
    echo "Warning: No free nbd device found; skipping partition/format of $disk"
    return 0
  fi

  echo "Formatting $disk as ext4 via $nbd_dev..."

  sudo modprobe nbd max_part=8
  sudo qemu-nbd -c "$nbd_dev" "$disk"

  # Wait briefly for the kernel to see the device
  sleep 0.5

  echo 'label: gpt' | sudo sfdisk "$nbd_dev"
  echo ';'        | sudo sfdisk "$nbd_dev"

  # Format the first partition (sfdisk with ';' fills the whole disk as partition 1)
  sudo mkfs.ext4 -F "${nbd_dev}p1"

  sudo qemu-nbd -d "$nbd_dev"
  echo "Formatted $disk successfully."
  echo ""
}

function generate_host() {
  local host="$1"
  local default_user="$2"
  local default_pass="$3"
  local default_os="$4"
  local default_bridge="$5"
  local default_storage_size="$6"
  local meta_data_tpl_content="$7"
  local user_data_tpl_content="$8"
  local network_cfg_tpl_content="$9"
  local name=$(echo "$host" | yq '.name')
  local ip=$(echo "$host" | yq '.ip')
  # Per-host bridge override; falls back to the default bridge from vms.yml
  local bridge=$(echo "$host" | yq '.bridge // ""' )
  if [[ -z "$bridge" ]]; then
    bridge="$default_bridge"
  fi
  # Optional per-host VLAN tag (empty means untagged)
  local vlan=$(echo "$host" | yq '.vlan // ""' )
  # Derive gateway from IP (replace last octet with .1)
  local gateway=$(echo "$ip" | sed 's/\.[0-9]*$/.1/')

  local os_name=$(copy_base_os_image "$name")
  echo "Processing host: $name with IP: $ip (OS: $os_name, bridge: $bridge${vlan:+, vlan: $vlan})"

  # generate config files for cloud-init to config folder
  local config_dir="$ASSETS_DIR/$name/config"
  mkdir -p "$config_dir"

  render_j2_content "$meta_data_tpl_content"   "$config_dir/meta-data" "name=$name"
  render_j2_content "$user_data_tpl_content"   "$config_dir/user-data" "user=$default_user" "pass=$default_pass" "name=$name"
  render_j2_content "$network_cfg_tpl_content" "$config_dir/network-config" "ip=$ip" "gateway=$gateway" "name=$name"

  # generate iso image with cloud-init config files
  local seed_img="$ASSETS_DIR/$name/seed.img"
  # Delete the existing seed image if it exists
  if [[ -f "${seed_img}" ]]; then
    rm -f "${seed_img}"
  fi
  genisoimage \
    -output "$seed_img" \
    -volid cidata -rational-rock -joliet \
    "$config_dir/user-data" "$config_dir/meta-data" "$config_dir/network-config"
  echo "Generated cloud-init seed image for $name at $seed_img"
  echo ""

  # generate storage file if it doesn't exist
  if [[ ! -f "${name}-data.qcow2" ]]; then
    qemu-img create -f qcow2 "${name}-data.qcow2" "$default_storage_size"
    echo "Generated storage file for $name at ${name}-data.qcow2 with size $default_storage_size"
    format_data_disk "${name}-data.qcow2"
  else
    echo "Storage file already exists for $name at ${name}-data.qcow2 — preserved"
    echo ""
  fi
}

function do_gen-cloud-init() {
  local meta_data_tpl_content="$1"
  local user_data_tpl_content="$2"
  local network_cfg_tpl_content="$3"

  echo "Generating cloud-init configuration for all hosts defined in vms.yml..."
  echo ""

  if [[ -z "$meta_data_tpl_content" || -z "$user_data_tpl_content" || -z "$network_cfg_tpl_content" ]]; then
    echo "Error: Missing template content arguments."
    exit 1
  fi

  if [[ ! -f "vms.yml" ]]; then
    echo "Error: vms.yml not found in the current directory. Please ensure you are in the correct directory and that vms.yml exists."
    exit 1
  fi

  # check required tools are installed
  for tool in yq genisoimage qemu-img qemu-nbd sfdisk mkfs.ext4; do
    if ! command -v "$tool" &> /dev/null; then
      echo "Error: $tool is not installed. Please install it and try again."
      exit 1
    fi
  done

  local default_user=$(yq '.defaults.user' vms.yml)
  local default_pass=$(yq '.defaults.pass' vms.yml)
  local default_os=$(yq '.defaults.os' vms.yml)
  local default_bridge=$(yq '.defaults.bridge' vms.yml)
  local default_storage_size=$(yq '.defaults.storage_size' vms.yml)

  # Ensure the bridge used for qemu networking exists on the host before generating any per-VM configuration.
  check_bridge

  readarray -t hosts < <(yq -o=json -I=0 '.hosts[]' vms.yml)
  for host in "${hosts[@]}"; do
    generate_host "$host" "$default_user" "$default_pass" "$default_os" "$default_bridge" "$default_storage_size" "$meta_data_tpl_content" "$user_data_tpl_content" "$network_cfg_tpl_content"
  done
}