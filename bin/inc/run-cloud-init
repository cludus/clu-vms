# root_dir is inherited from the calling script (cvms.sh) and points to the root directory of the project.
ROOT_DIR="${root_dir:-$(pwd)}"

function run-cloud-init_help() {
  echo "======================="
  echo "Run Cloud-Init Configuration"
  echo "  Usage: $0 run-cloud-init"
  echo "  Runs the cloud-init process."
  echo ""
}

function process_host() {
  local host="$1"
  local os_name="$2"
  local name=$(echo "$host" | yq '.name')
  local ip=$(echo "$host" | yq '.ip')
  echo "Running host: $name with IP: $ip ..."

  local os_image="$name/$os_name.img"
  local seed_img="$name/seed.img"
  local data_img="$name/data.qcow2"

  # check required images are present
  for img in "$os_image" "$seed_img" "$data_img"; do
    if [[ ! -f "$img" ]]; then
      echo "Error: Required image $img not found."
      exit 1
    fi
  done

  local default_bridge="$3"
  # Per-host bridge override; falls back to the default bridge from vms.yml
  local bridge=$(echo "$host" | yq '.bridge // ""' )
  if [[ -z "$bridge" ]]; then
    bridge="$default_bridge"
  fi

  # create vm with qemu command (check how to run in background)
  qemu-system-x86_64 -enable-kvm -m 2G -cpu host \
    -drive file="$os_image",if=virtio,format=qcow2 \
    -drive file="$data_img",if=virtio,format=qcow2 \
    -drive file="$seed_img",if=virtio,format=raw \
    -netdev bridge,id=net0,br="$bridge" \
    -device virtio-net-pci,netdev=net0
  # NOTE: when a vlan tag is set, add vlan=ID to the -netdev argument, e.g.
  #   -netdev bridge,id=net0,br="$bridge",vlan=12 \
  #   -device virtio-net-pci,netdev=net0
}

function do_run-cloud-init() {
  echo "Running cloud-init vms for all hosts defined in vms.yml..."
  echo ""

  if [[ ! -f "vms.yml" ]]; then
    echo "Error: vms.yml not found in the current directory. Please ensure you are in the correct directory and that vms.yml exists."
    exit 1
  fi

  # check required tools are installed
  for tool in yq qemu-system-x86_64; do
    if ! command -v "$tool" &> /dev/null; then
      echo "Error: $tool is not installed. Please install it and try again."
      exit 1
    fi
  done

  local default_os=$(yq '.defaults.os' vms.yml)

  readarray -t hosts < <(yq -o=json -I=0 '.hosts[]' vms.yml)
  for host in "${hosts[@]}"; do
    process_host "$host" "$default_os"
  done
}