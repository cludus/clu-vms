#!/usr/bin/env bash

ROOT_SCRIPT="${ROOT_SCRIPT:-cvms}"
ASSETS_DIR="${ASSETS_DIR:-.assets}"

function run-cloud-init_help() {
  echo "======================="
  echo "Run Cloud-Init Configuration"
  echo "  Usage: $ROOT_SCRIPT run-cloud-init [--foreground]"
  echo "  Runs the cloud-init process."
  echo "  Options:"
  echo "    --foreground  Run QEMU in the foreground (default: daemonize)."
  echo ""
}

function cloud_init_process_host() {
  local host="$1"
  local os_name="$2"
  local foreground="$3"
  local default_bridge="$4"
  local default_memory="$5"
  local name=$(echo "$host" | yq '.name')
  local ip=$(echo "$host" | yq '.ip')
  echo "Running host: $name with IP: $ip ..."

  local os_image="$ASSETS_DIR/$name/$os_name.img"
  local seed_img="$ASSETS_DIR/$name/seed.img"
  local data_img="${name}-data.qcow2"

  # check required images are present
  for img in "$os_image" "$seed_img" "$data_img"; do
    if [[ ! -f "$img" ]]; then
      echo "Error: Required image $img not found."
      exit 1
    fi
  done

  # Per-host bridge override; falls back to the default bridge from vms.yml
  local bridge=$(echo "$host" | yq '.bridge // ""' )
  if [[ -z "$bridge" ]]; then
    bridge="$default_bridge"
  fi

  # Per-host memory override; falls back to the default memory from vms.yml
  local memory=$(echo "$host" | yq '.memory // ""' )
  if [[ -z "$memory" ]]; then
    memory="$default_memory"
  fi

  # build qemu daemon args
  local daemon_args=()
  if [[ "$foreground" != "1" ]]; then
    daemon_args=(-daemonize -pidfile "$name/qemu.pid")
    echo "  Daemonizing (PID file: $name/qemu.pid) ..."
  else
    echo "  Running in foreground mode ..."
  fi

  # create vm with qemu command
  qemu-system-x86_64 -enable-kvm -m "$memory" -cpu host \
    "${daemon_args[@]}" \
    -drive file="$os_image",if=virtio,format=qcow2 \
    -drive file="$data_img",if=virtio,format=qcow2 \
    -drive file="$seed_img",if=virtio,format=raw \
    -netdev bridge,id=net0,br="$bridge" \
    -device virtio-net-pci,netdev=net0
  # NOTE: when a vlan tag is set, add vlan=ID to the -netdev argument, e.g.
  #   -netdev bridge,id=net0,br="$bridge",vlan=12 \
  #   -device virtio-net-pci,netdev=net0
}

function do_run-cloud-init() {
  local foreground=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --foreground) foreground=1; shift ;;
    esac
  done

  echo "Running cloud-init vms for all hosts defined in vms.yml..."
  echo ""

  if [[ ! -f "vms.yml" ]]; then
    echo "Error: vms.yml not found in the current directory. Please ensure you are in the correct directory and that vms.yml exists."
    exit 1
  fi

  # check required tools are installed
  for tool in yq qemu-system-x86_64; do
    if ! command -v "$tool" &> /dev/null; then
      echo "Error: $tool is not installed. Please install it and try again."
      exit 1
    fi
  done

  local default_os=$(yq '.defaults.os' vms.yml)
  local default_bridge=$(yq '.defaults.bridge' vms.yml)
  local default_memory=$(yq '.defaults.memory' vms.yml)

  # Ensure the bridge used for qemu networking exists on the host before launching any VMs.
  check_bridge

  readarray -t hosts < <(yq -o=json -I=0 '.hosts[]' vms.yml)
  for host in "${hosts[@]}"; do
    cloud_init_process_host "$host" "$default_os" "$foreground" "$default_bridge" "$default_memory"
  done
}