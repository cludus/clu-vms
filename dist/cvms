function download_image() {
  local image_name="$1"
  local url="$2"
  local dest_file="$3"
  local tmp_file="${dest_file}.tmp"

  rm -f "$tmp_file"
  echo ""
  echo "Downloading ${image_name}..."

  if ! curl -fL --retry 3 --retry-delay 2 --connect-timeout 15 "$url" -o "$tmp_file"; then
    rm -f "$tmp_file"
    echo "Error: Failed to download ${image_name} from $url"
    exit 1
  fi

  local size_bytes
  size_bytes=$(wc -c < "$tmp_file")
  if [[ "$size_bytes" -eq 0 ]]; then
    rm -f "$tmp_file"
    echo "Error: Downloaded ${image_name} is empty from $url"
    exit 1
  fi

  mv "$tmp_file" "$dest_file"
}

