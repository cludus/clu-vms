# Renders a Jinja2 template string to a file using JSON-encoded context values.
# First argument is the template content, second argument is the output file
# path, and the rest are key=json_value pairs. Each value MUST be valid JSON
# (e.g. "string", 42, ["a","b"], {"key":"val"}). This variant supports lists
# and other complex types that render_j2_content cannot express via plain
# key=value strings.
function render_j2_content_json() {
  if ! python3 -c "import jinja2" &> /dev/null; then
    echo "Error: Python jinja2 module is not installed. Please run: pip install jinja2"
    exit 1
  fi

  local tpl_content="$1"
  local out_path="$2"
  shift 2

  python3 -c '
import jinja2, sys, json
tpl_content = sys.argv[1]
out_path = sys.argv[2]
ctx = {}
for arg in sys.argv[3:]:
    k, v = arg.split("=", 1)
    ctx[k] = json.loads(v)
tpl = jinja2.Template(tpl_content)
with open(out_path, "w") as f:
    f.write(tpl.render(**ctx))
' "$tpl_content" "$out_path" "$@"
}

# Utility: encode a raw string as a JSON string (with quotes).
# Usage: v=$(json_str "hello world")  =>  "hello world"
function json_str() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

# Generate a SHA-512 password hash suitable for Flatcar Butane passwd.users.
# Uses mkpasswd, openssl, or Python crypt (tried in that order).
# Usage: ph=$(hash_password "changeme")
function hash_password() {
  local pass="$1"

  if command -v mkpasswd &> /dev/null; then
    mkpasswd -m sha-512 "$pass" 2>/dev/null && return 0
  fi

  if command -v openssl &> /dev/null; then
    local h
    h=$(openssl passwd -6 "$pass" 2>/dev/null) && { echo "$h"; return 0; }
  fi

  if python3 -c "import crypt" &> /dev/null; then
    python3 -c "
import crypt, sys
print(crypt.crypt(sys.argv[1], crypt.mksalt(crypt.METHOD_SHA512)))
" "$pass" 2>/dev/null && return 0
  fi

  echo "Error: Unable to hash password — install mkpasswd, openssl, or Python crypt module." >&2
  exit 1
}

# Validate host authentication settings by effective OS.
# - flatcar: requires pass OR at least one ssh_authorized_key.
# - non-flatcar: requires a non-empty pass.
function validate_host_auth_config() {
  local host_json="$1"
  local default_os="$2"
  local default_pass="$3"
  local default_ssh_keys_len="${4:-0}"

  local host_name host_os effective_os host_pass effective_pass
  local host_ssh_keys_len effective_ssh_keys_len

  host_name=$(echo "$host_json" | yq '.name // ""')
  host_os=$(echo "$host_json" | yq '.os // ""')
  effective_os="$host_os"
  if [[ -z "$effective_os" || "$effective_os" == "null" ]]; then
    effective_os="$default_os"
  fi

  host_pass=$(echo "$host_json" | yq '.pass // ""')
  effective_pass="$host_pass"
  if [[ -z "$effective_pass" || "$effective_pass" == "null" ]]; then
    effective_pass="$default_pass"
  fi

  host_ssh_keys_len=$(echo "$host_json" | yq '.ssh_authorized_keys // [] | length')
  effective_ssh_keys_len="$host_ssh_keys_len"
  if [[ "$effective_ssh_keys_len" -eq 0 ]]; then
    effective_ssh_keys_len="$default_ssh_keys_len"
  fi

  if [[ "$effective_os" == "flatcar" ]]; then
    if [[ -z "$effective_pass" || "$effective_pass" == "null" ]] && [[ "$effective_ssh_keys_len" -eq 0 ]]; then
      echo "Error: Host '$host_name' (os=flatcar) must define at least one authentication method: pass or ssh_authorized_keys."
      return 1
    fi
    return 0
  fi

  if [[ -z "$effective_pass" || "$effective_pass" == "null" ]]; then
    echo "Error: Host '$host_name' (os=$effective_os) must define a non-empty pass."
    return 1
  fi

  return 0
}

# Checks that the bridge interface used for qemu networking exists on the host.
# Bridge configuration is read from vms.yml:
#   bridge:
#     name: vmbr0              # bridge name (falls back to defaults.bridge)
#     phys_if: eth1            # physical interface to enslave (auto-detected if omitted)
#     ip: 10.146.101.1/24      # bridge IP/CIDR (auto-derived from VM subnet if omitted)
#     create: true|false       # when true, auto-create the bridge if missing
# If the bridge is missing and create is false, prints the commands needed to
# create it and exits.
function check_bridge() {
  local bridge=""
  local phys_if=""
  local bridge_cidr=""
  local create_bridge=0

  # Verify required tools are available
  if ! command -v yq &> /dev/null; then
    echo "Error: yq is not installed. Please install it and try again."
    exit 1
  fi
  if ! command -v ip &> /dev/null; then
    echo "Error: ip (iproute2) is not installed. Please install it and try again."
    exit 1
  fi
  if ! command -v sudo &> /dev/null; then
    echo "Error: sudo is not installed. Please install it and try again."
    exit 1
  fi

  # Read bridge configuration from vms.yml.
  if [[ ! -f "vms.yml" ]]; then
    echo "Error: vms.yml not found. Bridge configuration is required."
    exit 1
  fi

  local cfg_name cfg_phys cfg_ip cfg_create
  cfg_name=$(yq '.bridge.name // ""' vms.yml 2>/dev/null)
  cfg_phys=$(yq '.bridge.phys_if // ""' vms.yml 2>/dev/null)
  cfg_ip=$(yq '.bridge.ip // ""' vms.yml 2>/dev/null)
  cfg_create=$(yq '.bridge.create // ""' vms.yml 2>/dev/null)
  bridge="$cfg_name"
  phys_if="$cfg_phys"
  bridge_cidr="$cfg_ip"
  [[ "$cfg_create" == "true" ]] && create_bridge=1

  # Fall back to defaults.bridge if no bridge name was resolved from bridge.name
  if [[ -z "$bridge" ]]; then
    bridge=$(yq '.defaults.bridge // "vmbr0"' vms.yml 2>/dev/null)
  fi

  if ip link show "$bridge" &> /dev/null; then
    echo "Bridge $bridge exists on the host."
    return 0
  fi

  echo "Warning: Bridge $bridge does not exist on the host."

  # Auto-detect a physical interface if none was provided: prefer the default
  # route's interface, falling back to the first non-loopback interface.
  if [[ -z "$phys_if" ]]; then
    phys_if=$(ip -o route show default 2>/dev/null | awk '{print $5}' | head -n1)
    if [[ -z "$phys_if" ]]; then
      phys_if=$(ip -o link show | awk -F': ' '$2 != "lo" {print $2}' | head -n1)
    fi
  fi

  # Derive a bridge IP/CIDR from the VM subnet if none was provided. Uses the
  # first host IP in vms.yml, replaces the last octet with .1, and assumes /24.
  if [[ -z "$bridge_cidr" ]]; then
    local first_ip
    first_ip=$(yq -o=json -I=0 '.hosts[0].ip' vms.yml 2>/dev/null)
    if [[ -n "$first_ip" ]]; then
      local gateway
      gateway=$(echo "$first_ip" | sed 's/\.[0-9]*$/.1/')
      bridge_cidr="${gateway}/24"
    fi
  fi

  echo ""
  echo "To create the bridge $bridge run the following commands:"
  echo "  sudo ip link add name $bridge type bridge"
  echo "  sudo ip link set $bridge up"
  if [[ -n "$phys_if" ]]; then
    echo "  sudo ip link set $phys_if up"
    echo "  sudo ip link set $phys_if master $bridge"
    echo "  sudo ip addr flush dev $phys_if"
  fi
  if [[ -n "$bridge_cidr" ]]; then
    echo "  sudo ip addr add $bridge_cidr dev $bridge"
  fi
  echo ""

  if [[ "$create_bridge" == "1" ]]; then
    echo "Attempting to create bridge $bridge..."
    sudo ip link add name "$bridge" type bridge
    sudo ip link set "$bridge" up
    if [[ -n "$phys_if" ]]; then
      sudo ip link set "$phys_if" up
      sudo ip link set "$phys_if" master "$bridge"
      sudo ip addr flush dev "$phys_if"
    fi
    if [[ -n "$bridge_cidr" ]]; then
      sudo ip addr add "$bridge_cidr" dev "$bridge"
    fi
    if ip link show "$bridge" &> /dev/null; then
      echo "Bridge $bridge created successfully."
    else
      echo "Error: Failed to create bridge $bridge."
      exit 1
    fi
  else
    echo "Set 'bridge.create: true' in vms.yml to create it automatically, or create it manually."
    exit 1
  fi
}

# Partition and format a qcow2 data disk with a single ext4 partition via NBD.
# Usage: format_data_disk <qcow2_path>
function format_data_disk() {
  local disk="$1"

  # Find a free nbd device
  local nbd_dev=""
  for nbd in /dev/nbd[0-9]*; do
    local idx="${nbd#/dev/nbd}"
    local size_file="/sys/class/block/nbd${idx}/size"
    if [[ -f "$size_file" ]]; then
      local sz
      sz=$(cat "$size_file" 2>/dev/null)
      if [[ "$sz" == "0" ]]; then
        nbd_dev="$nbd"
        break
      fi
    fi
  done

  if [[ -z "$nbd_dev" ]]; then
    echo "Warning: No free nbd device found; skipping partition/format of $disk"
    return 0
  fi

  echo "Formatting $disk as ext4 via $nbd_dev..."

  sudo modprobe nbd max_part=8
  sudo qemu-nbd -c "$nbd_dev" "$disk"

  # Wait briefly for the kernel to see the device
  sleep 0.5

  echo 'label: gpt' | sudo sfdisk "$nbd_dev"
  echo ';'        | sudo sfdisk "$nbd_dev"

  # Format the first partition (sfdisk with ';' fills the whole disk as partition 1)
  sudo mkfs.ext4 -F "${nbd_dev}p1"

  sudo qemu-nbd -d "$nbd_dev"
  echo "Formatted $disk successfully."
  echo ""
}

function copy_base_os_image() {
  local os_name="${1:-alpine}"  # Default to "alpine" if not provided
  local vm_name="$2"
  local os_image="$os_name.img"

  local source_dir="$ASSETS_DIR/imgs"
  local source_file="${source_dir}/${os_image}"
  if [[ ! -f "$source_file" ]]; then
    echo "Error: Base OS image $source_file not found. Please run the download command first."
    exit 1
  fi

  local dest="$ASSETS_DIR/${vm_name}/${os_image}"
  mkdir -p "$ASSETS_DIR/$vm_name"
  # Delete the existing OS image if it exists
  if [[ -f "$dest" ]]; then
    rm -f "$dest"
  fi
  cp "$source_file" "$dest"

  echo "$os_name"
}


