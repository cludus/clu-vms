# Downloads the latest cloud images for Alpine Linux and Ubuntu Server.
function do_download() {
  DEST_DIR="$ASSETS_DIR/imgs"
  mkdir -p "$DEST_DIR"

  # alpine
  ALPINE_MAJOR_VERSION="3.24"
  ALPINE_FULL_VERSION="3.24.1"
  ALPINE_DEST_FILE="$DEST_DIR/alpine.img"
  rm -f "$ALPINE_DEST_FILE"
  download_image \
    "Alpine Linux cloud image version ${ALPINE_FULL_VERSION}" \
    "https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_MAJOR_VERSION}/releases/cloud/generic_alpine-${ALPINE_FULL_VERSION}-x86_64-bios-cloudinit-r0.qcow2" \
    "$ALPINE_DEST_FILE"

  # ubuntu
  UBUNTU_DEST_FILE="$DEST_DIR/ubuntu.img"
  rm -f "$UBUNTU_DEST_FILE"
  download_image \
    "Ubuntu Server cloud image" \
    "https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img" \
    "$UBUNTU_DEST_FILE"

  # flatcar
  FLATCAR_DEST_FILE="$DEST_DIR/flatcar.img"
  rm -f "$FLATCAR_DEST_FILE"
  download_image \
    "Flatcar Linux cloud image" \
    "https://stable.release.flatcar-linux.net/amd64-usr/current/flatcar_production_qemu_image.img" \
    "$FLATCAR_DEST_FILE"

  echo ""
  echo "Download complete. Images saved to $DEST_DIR"
}


